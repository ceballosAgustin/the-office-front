---
import "../styles/global.css";
import Navbar from "../components/ui/Navbar.astro";
import ShippingAndPaymentSection from "../components/ui/ShippingAndPaymentSection.astro";
import { WHATSAPP_CONTACT_URL, SOCIAL_LINKS } from "../utils/contact";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  noCanonical?: boolean;
  hideTrustBanner?: boolean;
}

const {
  title = "The Office BA — Indumentaria y Calzado Urbano",
  description = "Productos 100% originales con stock inmediato. Sneakers exclusivos, indumentaria urbana y las marcas en tendencia más buscadas con envíos a todo el país.",
  image,
  canonicalPath,
  noCanonical = false,
  hideTrustBanner = false,
} = Astro.props;

// Canonical domain is strictly the apex domain https://theofficeba.ar
const canonicalOrigin = Astro.site ? Astro.site.origin : "https://theofficeba.ar";

// Clean pathname without trailing slash (except root) and strictly without query params or hash
const rawPath = canonicalPath || Astro.url.pathname;
const cleanPath = rawPath === "/" ? "" : rawPath.replace(/\/+$/, "");

// Do not generate build-time canonical or og:url for fallback templates or when explicitly disabled
const isFallbackTemplate = noCanonical || rawPath.toLowerCase().includes("/fallback");
const canonicalUrl = !isFallbackTemplate ? `${canonicalOrigin}${cleanPath || "/"}` : null;

// Open Graph / Twitter image: only when a valid, appropriate image is provided
const socialImage = image && image.trim().length > 0
  ? (image.startsWith("http") ? image.trim() : `${canonicalOrigin}${image.startsWith("/") ? "" : "/"}${image.trim()}`)
  : null;

---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAFAFA" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Canonical URL -->
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="The Office BA" />
    {socialImage && <meta property="og:image" content={socialImage} />}

    <!-- Twitter / X -->
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
  </head>
  <body
    class="flex flex-col min-h-screen selection:bg-brand-dark selection:text-[#FAFAFA]"
  >
    <Navbar />

    <main class="flex-1">
      <slot />
    </main>

    <!-- Global Shipping & Payment Info Pre-Footer Section -->
    {!hideTrustBanner && <ShippingAndPaymentSection />}

    <!-- Footer: bloque oscuro inset -->
    <footer class="mx-auto mt-auto w-full max-w-7xl px-3 pb-3 pt-2 sm:px-4 sm:pb-4">
      <div class="rounded-tile bg-brand-dark px-5 py-9 text-brand-light sm:px-10 sm:py-14">
        <div class="grid grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-12 md:gap-x-8">
          <!-- Marca -->
          <div class="col-span-2 space-y-4 md:col-span-5">
            <span class="inline-flex items-baseline text-xl font-bold uppercase tracking-tight text-brand-sand sm:text-2xl">
              THE OFFICE
              <sup class="relative -top-1.5 ml-0.5 text-xs font-bold leading-none text-brand-sand">BA</sup>
            </span>
            <p class="max-w-sm text-sm leading-relaxed text-brand-light/70">
              Productos 100% originales con stock inmediato. Las marcas en tendencia
              más solicitadas de indumentaria urbana y sneakers con envíos seguros a todo el país.
            </p>
          </div>

          <!-- Tienda -->
          <nav class="space-y-1 md:col-span-2" aria-label="Tienda">
            <h2 class="text-[13px] font-semibold text-brand-sand">Tienda</h2>
            <ul>
              <li><a href="/#recien-ingresados" class="inline-flex min-h-11 items-center gap-2.5 text-sm text-brand-light/70 transition-colors duration-150 hover:text-brand-light focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-sand">Recién ingresados</a></li>
              <li><a href="/#catalogo" class="inline-flex min-h-11 items-center gap-2.5 text-sm text-brand-light/70 transition-colors duration-150 hover:text-brand-light focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-sand">Todo el catálogo</a></li>
              <li><a href="/cart" class="inline-flex min-h-11 items-center gap-2.5 text-sm text-brand-light/70 transition-colors duration-150 hover:text-brand-light focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-sand">Carrito</a></li>
            </ul>
          </nav>

          <!-- Ayuda -->
          <nav class="space-y-1 md:col-span-2" aria-label="Ayuda">
            <h2 class="text-[13px] font-semibold text-brand-sand">Ayuda</h2>
            <ul>
              <li><a href="/#envios-y-pagos" class="inline-flex min-h-11 items-center gap-2.5 text-sm text-brand-light/70 transition-colors duration-150 hover:text-brand-light focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-sand">Envíos y pagos</a></li>
            </ul>
          </nav>

          <!-- Contacto (única entrada de WhatsApp del footer) -->
          <div class="col-span-2 space-y-1 sm:col-span-1 md:col-span-3">
            <h2 class="text-[13px] font-semibold text-brand-sand">Contacto</h2>
            <ul>
              <li>
                <a href={WHATSAPP_CONTACT_URL} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2.5 text-sm text-brand-light/70 transition-colors duration-150 hover:text-brand-light focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-sand">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true">
                    <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"></path>
                    <path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"></path>
                  </svg>
                  <span>WhatsApp</span>
                </a>
              </li>
              <li>
                <a href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2.5 text-sm text-brand-light/70 transition-colors duration-150 hover:text-brand-light focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-sand">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="shrink-0" aria-hidden="true">
                    <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                    <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                  </svg>
                  <span>Instagram</span>
                </a>
              </li>
            </ul>
          </div>
        </div>

        <!-- Bottom bar -->
        <div class="mt-10 flex flex-col items-start justify-between gap-2 border-t border-brand-light/15 pt-6 sm:flex-row sm:items-center sm:gap-4">
          <p class="text-xs text-brand-light/70">
            &copy; {new Date().getFullYear()} The Office BA. Todos los derechos reservados.
          </p>
          <div class="flex items-center gap-3">
            <p class="text-xs text-brand-light/70">Buenos Aires, Argentina</p>
            <span class="select-none text-xs text-brand-light/40" aria-hidden="true">/</span>
            <a
              href="/admin/login"
              class="inline-flex min-h-11 items-center rounded-full px-1 text-xs text-brand-light/70 transition-colors duration-150 hover:text-brand-light focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-sand"
            >
              Admin
            </a>
          </div>
        </div>
      </div>
    </footer>

  </body>
</html>
