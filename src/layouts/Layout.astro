---
import "../styles/global.css";
import Navbar from "../components/ui/Navbar.astro";
import { WHATSAPP_CONTACT_URL, SOCIAL_LINKS } from "../utils/contact";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "The Office BA — Friends and Family",
  description = "Colección de indumentaria urbana contemporánea. Siluetas estructuradas, telas pesadas y calzado curado. Envíos a todo el país.",
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAFAFA" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body
    class="flex flex-col min-h-screen selection:bg-brand-dark selection:text-[#FAFAFA]"
  >
    <Navbar />

    <main class="flex-1">
      <slot />
    </main>

    <!-- Minimalist Editorial Footer -->
    <footer
      class="border-t border-brand-dark/[0.08] mt-auto bg-[#FAFAFA]/70 backdrop-blur-xs"
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-12 md:py-16">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
          <!-- Column A: Brand Information (The Office BA) -->
          <div class="md:col-span-6 space-y-3">
            <span
              class="text-sm font-bold tracking-tight text-brand-dark uppercase inline-flex items-baseline"
            >
              THE OFFICE
              <sup
                class="text-[8px] font-bold relative -top-1 ml-0.5 leading-none text-brand-dark"
                >BA</sup
              >
            </span>
            <p
              class="text-xs sm:text-sm text-brand-dark/55 max-w-sm leading-relaxed"
            >
              Estudio de indumentaria urbana y calzado contemporáneo. Piezas
              desarrolladas con precisión formal y materiales duraderos.
            </p>
          </div>

          <!-- Column B: Atención al Cliente -->
          <div class="md:col-span-3 space-y-3">
            <h2
              class="text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-dark/45"
            >
              Atención al Cliente
            </h2>
            <ul class="space-y-2">
              <li>
                <a
                  href={WHATSAPP_CONTACT_URL}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2.5 py-1.5 text-xs sm:text-sm text-brand-dark/70 hover:text-brand-dark transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-dark/30 rounded-xs"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="shrink-0 text-brand-dark/65"
                    aria-hidden="true"
                  >
                    <path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"></path>
                    <path
                      d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"
                    ></path>
                  </svg>
                  <span>Contactar por WhatsApp</span>
                </a>
              </li>
            </ul>
          </div>

          <!-- Column C: Redes Sociales -->
          <div class="md:col-span-3 space-y-3">
            <h2
              class="text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-dark/45"
            >
              Redes Sociales
            </h2>
            <ul class="space-y-2">
              <li>
                <a
                  href={SOCIAL_LINKS.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2.5 py-1.5 text-xs sm:text-sm text-brand-dark/70 hover:text-brand-dark transition-colors duration-150 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-dark/30 rounded-xs"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="shrink-0 text-brand-dark/65"
                    aria-hidden="true"
                  >
                    <rect width="20" height="20" x="2" y="2" rx="5" ry="5"
                    ></rect>
                    <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"
                    ></path>
                    <line x1="17.5" x2="17.51" y1="6.5" y2="6.5"></line>
                  </svg>
                  <span>Instagram</span>
                </a>
              </li>
            </ul>
          </div>
        </div>

        <!-- Bottom bar -->
        <div
          class="mt-12 pt-6 border-t border-brand-dark/[0.06] flex flex-col sm:flex-row items-center justify-between gap-4"
        >
          <p class="text-[11px] text-brand-dark/40">
            &copy; {new Date().getFullYear()} The Office BA. All rights reserved.
          </p>
          <div class="flex items-center gap-3.5">
            <a
              href="/admin/login"
              class="text-[11px] font-mono tracking-wider text-brand-dark/40 hover:text-brand-dark transition-colors duration-150 uppercase focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-dark/30 rounded-xs"
            >
              Admin Access
            </a>
            <span
              class="text-[11px] text-brand-dark/20 select-none"
              aria-hidden="true">/</span
            >
            <p
              class="text-[11px] font-mono tracking-wider text-brand-dark/30 uppercase"
            >
              Buenos Aires, AR
            </p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
