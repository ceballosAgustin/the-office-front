---
import Layout from '../layouts/Layout.astro';
import CatalogSection from '../components/react/CatalogSection.jsx';
import NewInSection from '../components/react/NewInSection.jsx';
import HeroSpotlight from '../components/react/HeroSpotlight.jsx';
import BrandStrip from '../components/react/BrandStrip.jsx';
---

<Layout
  title="The Office BA — Indumentaria y Calzado | Stock Inmediato"
  description="Productos 100% originales con stock inmediato. Las marcas en tendencia más solicitadas de indumentaria urbana y sneakers con envíos a todo el país."
>
  <!-- Hero -->
  <section class="mx-auto max-w-7xl px-4 pt-5 sm:px-6 sm:pt-10 lg:px-8 lg:pt-14">
    <div class="grid grid-cols-1 items-stretch gap-6 lg:grid-cols-12 lg:gap-8">
      <!-- Si el spotlight no tiene producto (island vacío), el texto ocupa todo el ancho -->
      <div class="flex flex-col justify-center lg:col-span-7 lg:py-10 lg:[&:has(~astro-island:empty)]:col-span-12">
        <span
          class="inline-flex w-fit items-center gap-2 rounded-full bg-brand-dark px-3.5 py-1.5 text-[13px] font-medium text-brand-sand"
        >
          <span class="size-1.5 rounded-full bg-brand-sand" aria-hidden="true"></span>
          Stock inmediato
        </span>
        <h1
          class="mt-4 text-[2.125rem] leading-[1.06] font-semibold tracking-[-0.035em] text-brand-dark sm:mt-5 sm:text-6xl lg:text-display"
        >
          Indumentaria y Calzado.<br />
          <span class="text-ink-muted">Las marcas en tendencia más solicitadas.</span>
        </h1>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-muted sm:mt-5 sm:text-[17px]">
          Sneakers exclusivos, remeras, buzos y accesorios de las marcas más buscadas.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:mt-8 sm:flex-row">
          <a
            href="#recien-ingresados"
            class="inline-flex h-12 items-center justify-center gap-2 rounded-full bg-brand-dark px-7 text-[15px] font-semibold text-brand-light shadow-float transition duration-200 ease-ios hover:bg-ink-soft active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-dark"
          >
            Ver recién ingresados
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <a
            href="#catalogo"
            class="inline-flex h-12 items-center justify-center rounded-full bg-white px-7 text-[15px] font-semibold text-brand-dark shadow-hairline transition duration-200 ease-ios hover:shadow-card active:scale-[0.97] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-dark"
          >
            Explorar catálogo
          </a>
        </div>
        <ul
          class="mt-6 grid grid-cols-1 gap-3 text-sm font-medium text-brand-dark sm:mt-9 sm:flex sm:flex-wrap sm:gap-x-7"
        >
          <li class="inline-flex items-center gap-2.5">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3 4 6v6c0 4.5 3.2 8 8 9 4.8-1 8-4.5 8-9V6l-8-3Z"></path><path d="m9 12 2 2 4-4"></path></svg>
            100% originales
          </li>
          <li class="inline-flex items-center gap-2.5">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"></path><path d="M15 18H9"></path><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"></path><circle cx="17" cy="18" r="2"></circle><circle cx="7" cy="18" r="2"></circle></svg>
            Envíos a todo el país
          </li>
          <li class="inline-flex items-center gap-2.5">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="5" rx="2"></rect><line x1="2" x2="22" y1="10" y2="10"></line></svg>
            Varios medios de pago
          </li>
        </ul>
      </div>

      <!-- Spotlight: primer producto de "Recién ingresados" (comparte el request con NewInSection) -->
      <HeroSpotlight client:load />
    </div>
  </section>

  <!-- "Recién ingresados": up to 20 products picked and ordered by the admin -->
  <NewInSection client:load />

  <!-- Marcas (solo con 2 o más) -->
  <BrandStrip client:load />

  <!-- Interactive Catalog Connected to Backend API -->
  <CatalogSection client:load />
</Layout>
