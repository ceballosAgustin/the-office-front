---
// ShippingAndPaymentSection.astro — Información integral de Envíos y Métodos de Pago
---

<section
  class="border-t border-brand-dark/[0.08] bg-transparent py-12 md:py-16"
  aria-label="Envíos y métodos de pago"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
      <!-- ========================================== -->
      <!-- BLOQUE 1: INFORMACIÓN DE ENVÍOS            -->
      <!-- ========================================== -->
      <div
        class="lg:col-span-5 flex flex-col justify-between bg-white/70 border border-brand-dark/[0.08] rounded-xs p-6 sm:p-8 space-y-6 shadow-[0_1px_3px_rgba(0,0,0,0.02)]"
      >
        <div class="space-y-4">
          <!-- Tag superior -->
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
            <span
              class="text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-dark/50 font-mono"
            >
              Logística & Despachos
            </span>
          </div>

          <!-- Título principal con icono -->
          <div class="flex items-center gap-3">
            <div
              class="w-10 h-10 rounded-xs bg-brand-dark/[0.04] border border-brand-dark/[0.06] flex items-center justify-center shrink-0 text-brand-dark"
              aria-hidden="true"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"></path>
                <path d="M15 18H9"></path>
                <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"></path>
                <circle cx="17" cy="18" r="2"></circle>
                <circle cx="7" cy="18" r="2"></circle>
              </svg>
            </div>
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-brand-dark">
              Envíos
            </h2>
          </div>

          <!-- Frase canónica solicitada -->
          <p class="text-sm sm:text-base text-brand-dark/80 font-medium leading-relaxed">
            Envíos a todo el país por correo y motomensajería en caba y alrededores.
          </p>

          <p class="text-xs sm:text-sm text-brand-dark/60 leading-relaxed">
            Todos nuestros productos cuentan con stock inmediato y despacho seguro desde Buenos Aires para que recibas tu pedido en óptimas condiciones.
          </p>
        </div>

        <!-- Opciones de entrega detalladas -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-4 border-t border-brand-dark/[0.06]">
          <!-- Correo a todo el país -->
          <div class="flex items-start gap-2.5 p-3 rounded-xs bg-brand-dark/[0.02] border border-brand-dark/[0.04]">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="shrink-0 text-brand-dark/70 mt-0.5"
              aria-hidden="true"
            >
              <rect width="20" height="16" x="2" y="4" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <div class="space-y-0.5">
              <span class="text-xs font-semibold text-brand-dark block">Correo Nacional</span>
              <span class="text-[11px] text-brand-dark/60 block leading-tight">A todo el país con código de seguimiento</span>
            </div>
          </div>

          <!-- Motomensajería CABA y alrededores -->
          <div class="flex items-start gap-2.5 p-3 rounded-xs bg-brand-dark/[0.02] border border-brand-dark/[0.04]">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="shrink-0 text-brand-dark/70 mt-0.5"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <div class="space-y-0.5">
              <span class="text-xs font-semibold text-brand-dark block">Motomensajería</span>
              <span class="text-[11px] text-brand-dark/60 block leading-tight">Envíos rápidos en CABA y alrededores</span>
            </div>
          </div>
        </div>
      </div>

      <!-- ========================================== -->
      <!-- BLOQUE 2: MÉTODOS DE PAGO                  -->
      <!-- ========================================== -->
      <div
        class="lg:col-span-7 flex flex-col justify-between bg-white/70 border border-brand-dark/[0.08] rounded-xs p-6 sm:p-8 space-y-6 shadow-[0_1px_3px_rgba(0,0,0,0.02)]"
      >
        <div class="space-y-4">
          <!-- Tag superior -->
          <div class="flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-brand-dark/40"></span>
            <span
              class="text-[11px] font-semibold uppercase tracking-[0.2em] text-brand-dark/50 font-mono"
            >
              Transacciones Seguras
            </span>
          </div>

          <!-- Título principal con icono -->
          <div class="flex items-center gap-3">
            <div
              class="w-10 h-10 rounded-xs bg-brand-dark/[0.04] border border-brand-dark/[0.06] flex items-center justify-center shrink-0 text-brand-dark"
              aria-hidden="true"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect width="20" height="14" x="2" y="5" rx="2"></rect>
                <line x1="2" x2="22" y1="10" y2="10"></line>
              </svg>
            </div>
            <h2 class="text-xl sm:text-2xl font-bold tracking-tight text-brand-dark">
              Métodos de Pago
            </h2>
          </div>

          <p class="text-sm text-brand-dark/70 leading-relaxed">
            Aceptamos diversas modalidades de pago para que elijas la opción más conveniente al momento de confirmar tu pedido.
          </p>
        </div>

        <!-- Grilla de Métodos de Pago con iconos -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3 pt-2">
          <!-- 1. Efectivo -->
          <div
            class="flex items-center gap-3 p-3.5 rounded-xs bg-brand-dark/[0.02] border border-brand-dark/[0.06] hover:border-brand-dark/20 transition-colors duration-150"
          >
            <div
              class="w-9 h-9 rounded-xs bg-white border border-brand-dark/[0.08] flex items-center justify-center shrink-0 text-brand-dark"
              aria-hidden="true"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <rect width="20" height="12" x="2" y="6" rx="2"></rect>
                <circle cx="12" cy="12" r="2"></circle>
                <path d="M6 12h.01M18 12h.01"></path>
              </svg>
            </div>
            <div class="min-w-0">
              <span class="text-xs sm:text-sm font-semibold text-brand-dark block truncate">
                Efectivo
              </span>
              <span class="text-[11px] text-brand-dark/50 block truncate">
                Pesos o USD
              </span>
            </div>
          </div>

          <!-- 2. Transferencia -->
          <div
            class="flex items-center gap-3 p-3.5 rounded-xs bg-brand-dark/[0.02] border border-brand-dark/[0.06] hover:border-brand-dark/20 transition-colors duration-150"
          >
            <div
              class="w-9 h-9 rounded-xs bg-white border border-brand-dark/[0.08] flex items-center justify-center shrink-0 text-brand-dark"
              aria-hidden="true"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M3 21h18"></path>
                <path d="M3 10h18"></path>
                <path d="M5 10v11"></path>
                <path d="M9 10v11"></path>
                <path d="M15 10v11"></path>
                <path d="M19 10v11"></path>
                <path d="m12 2 10 5H2z"></path>
              </svg>
            </div>
            <div class="min-w-0">
              <span class="text-xs sm:text-sm font-semibold text-brand-dark block truncate">
                Transferencia
              </span>
              <span class="text-[11px] text-brand-dark/50 block truncate">
                Bancaria o virtual
              </span>
            </div>
          </div>

          <!-- 3. Criptomonedas -->
          <div
            class="flex items-center gap-3 p-3.5 rounded-xs bg-brand-dark/[0.02] border border-brand-dark/[0.06] hover:border-brand-dark/20 transition-colors duration-150"
          >
            <div
              class="w-9 h-9 rounded-xs bg-white border border-brand-dark/[0.08] flex items-center justify-center shrink-0 text-brand-dark"
              aria-hidden="true"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M9 8h4.5a2 2 0 1 1 0 4H9m0 0h5a2 2 0 1 1 0 4H9m0-8v8"></path>
                <path d="M11 6v2m2-2v2m-2 12v2m2-2v2"></path>
              </svg>
            </div>
            <div class="min-w-0">
              <span class="text-xs sm:text-sm font-semibold text-brand-dark block truncate">
                Criptomonedas
              </span>
              <span class="text-[11px] text-brand-dark/50 block truncate">
                USDT y principales
              </span>
            </div>
          </div>

          <!-- 4. PayPal (+5% extra) -->
          <div
            class="flex items-center gap-3 p-3.5 rounded-xs bg-brand-dark/[0.02] border border-brand-dark/[0.06] hover:border-brand-dark/20 transition-colors duration-150"
          >
            <div
              class="w-9 h-9 rounded-xs bg-white border border-brand-dark/[0.08] flex items-center justify-center shrink-0 text-brand-dark"
              aria-hidden="true"
            >
              <!-- PayPal Icon (Dual P Silhouette) -->
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944 3.72a.789.789 0 0 1 .777-.66h6.582c3.549 0 5.86 1.764 5.344 5.025-.433 2.73-2.394 4.58-5.187 4.58H9.378a.789.789 0 0 0-.777.66l-1.525 8.012z"
                ></path>
                <path
                  d="M18.847 8.085c-.433 2.73-2.394 4.58-5.187 4.58h-3.082a.789.789 0 0 0-.777.66l-1.525 8.012h4.606a.641.641 0 0 0 .633-.538l.68-4.304a.789.789 0 0 1 .777-.66h1.936c3.226 0 5.327-1.604 4.858-4.568-.31-1.956-1.564-3.182-2.92-3.182z"
                  opacity="0.65"
                ></path>
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-1.5">
                <span class="text-xs sm:text-sm font-semibold text-brand-dark block truncate">
                  PayPal
                </span>
                <span
                  class="inline-flex items-center text-[9px] font-mono font-semibold px-1 py-0.2 rounded-xs bg-brand-dark/[0.06] text-brand-dark/75 border border-brand-dark/[0.08]"
                >
                  +5% extra
                </span>
              </div>
              <span class="text-[11px] text-brand-dark/50 block truncate">
                Internacional
              </span>
            </div>
          </div>

          <!-- 5. Zelle (+5% extra) -->
          <div
            class="flex items-center gap-3 p-3.5 rounded-xs bg-brand-dark/[0.02] border border-brand-dark/[0.06] hover:border-brand-dark/20 transition-colors duration-150"
          >
            <div
              class="w-9 h-9 rounded-xs bg-white border border-brand-dark/[0.08] flex items-center justify-center shrink-0 text-brand-dark"
              aria-hidden="true"
            >
              <!-- Zelle Icon -->
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <line x1="12" y1="2" x2="12" y2="22"></line>
                <polyline points="7 6 17 6 7 18 17 18"></polyline>
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-1.5">
                <span class="text-xs sm:text-sm font-semibold text-brand-dark block truncate">
                  Zelle
                </span>
                <span
                  class="inline-flex items-center text-[9px] font-mono font-semibold px-1 py-0.2 rounded-xs bg-brand-dark/[0.06] text-brand-dark/75 border border-brand-dark/[0.08]"
                >
                  +5% extra
                </span>
              </div>
              <span class="text-[11px] text-brand-dark/50 block truncate">
                Directo en USD
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
