---
// ShippingAndPaymentSection.astro — Información de Envíos y Métodos de Pago (card compacta)

const stroke = {
  fill: "none",
  stroke: "currentColor",
  "stroke-width": "1.75",
  "stroke-linecap": "round",
  "stroke-linejoin": "round",
} as const;
---

<section id="envios-y-pagos" class="scroll-mt-20 pb-10 pt-8 md:pb-14 md:pt-12" aria-label="Envíos y métodos de pago">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div
      class="rounded-tile bg-white p-5 shadow-card sm:p-8 lg:p-10"
    >
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12 lg:gap-12">
        <!-- ENVÍOS -->
        <div class="lg:col-span-5">
          <h2 class="text-[1.5rem] font-semibold tracking-[-0.025em] text-brand-dark sm:text-[1.75rem]">
            Envíos
          </h2>
          <p class="mt-2 text-[15px] font-medium leading-relaxed text-brand-dark">
            Envíos a todo el país por correo y motomensajería en caba y alrededores.
          </p>
          <p class="mt-2 text-[14px] leading-relaxed text-ink-muted">
            Todos nuestros productos cuentan con stock inmediato y despacho seguro desde Buenos Aires para que recibas tu pedido en óptimas condiciones.
          </p>

          <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-1 xl:grid-cols-2">
            <div class="flex items-start gap-3 rounded-card bg-sunken p-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                {...stroke}
                class="mt-0.5 shrink-0 text-brand-dark"
                aria-hidden="true"
              >
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
              <div>
                <span class="block text-[14px] font-semibold text-brand-dark">Correo Nacional</span>
                <span class="mt-0.5 block text-xs leading-snug text-ink-muted">A todo el país con código de seguimiento</span>
              </div>
            </div>

            <div class="flex items-start gap-3 rounded-card bg-sunken p-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                {...stroke}
                class="mt-0.5 shrink-0 text-brand-dark"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <div>
                <span class="block text-[14px] font-semibold text-brand-dark">Motomensajería</span>
                <span class="mt-0.5 block text-xs leading-snug text-ink-muted">Envíos rápidos en CABA y alrededores</span>
              </div>
            </div>
          </div>
        </div>

        <!-- MÉTODOS DE PAGO -->
        <div class="lg:col-span-7">
          <h2 class="text-[1.5rem] font-semibold tracking-[-0.025em] text-brand-dark sm:text-[1.75rem]">
            Métodos de pago
          </h2>
          <p class="mt-2 text-[14px] leading-relaxed text-ink-muted">
            Aceptamos diversas modalidades de pago para que elijas la opción más conveniente al momento de confirmar tu pedido.
          </p>

          <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-6">
            <!-- 1. Efectivo -->
            <div class="flex items-center gap-3 rounded-card bg-sunken p-4 sm:col-span-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" {...stroke} class="shrink-0 text-brand-dark" aria-hidden="true">
                <rect width="20" height="12" x="2" y="6" rx="2"></rect>
                <circle cx="12" cy="12" r="2"></circle>
                <path d="M6 12h.01M18 12h.01"></path>
              </svg>
              <div class="min-w-0">
                <span class="block text-[14px] font-semibold text-brand-dark">Efectivo</span>
                <span class="block text-xs text-ink-muted">Pesos o USD</span>
              </div>
            </div>

            <!-- 2. Transferencia -->
            <div class="flex items-center gap-3 rounded-card bg-sunken p-4 sm:col-span-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" {...stroke} class="shrink-0 text-brand-dark" aria-hidden="true">
                <path d="M3 21h18"></path>
                <path d="M3 10h18"></path>
                <path d="M5 10v11"></path>
                <path d="M9 10v11"></path>
                <path d="M15 10v11"></path>
                <path d="M19 10v11"></path>
                <path d="m12 2 10 5H2z"></path>
              </svg>
              <div class="min-w-0">
                <span class="block text-[14px] font-semibold text-brand-dark">Transferencia</span>
                <span class="block text-xs text-ink-muted">Bancaria o virtual</span>
              </div>
            </div>

            <!-- 3. Criptomonedas -->
            <div class="flex items-center gap-3 rounded-card bg-sunken p-4 sm:col-span-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" {...stroke} class="shrink-0 text-brand-dark" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M9 8h4.5a2 2 0 1 1 0 4H9m0 0h5a2 2 0 1 1 0 4H9m0-8v8"></path>
                <path d="M11 6v2m2-2v2m-2 12v2m2-2v2"></path>
              </svg>
              <div class="min-w-0">
                <span class="block text-[14px] font-semibold text-brand-dark">Criptomonedas</span>
                <span class="block text-xs text-ink-muted">USDT y principales</span>
              </div>
            </div>

            <!-- 4. PayPal (+5% extra) -->
            <div class="flex items-center gap-3 rounded-card bg-sunken p-4 sm:col-span-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="shrink-0 text-brand-dark" aria-hidden="true">
                <path d="M7.076 21.337H2.47a.641.641 0 0 1-.633-.74L4.944 3.72a.789.789 0 0 1 .777-.66h6.582c3.549 0 5.86 1.764 5.344 5.025-.433 2.73-2.394 4.58-5.187 4.58H9.378a.789.789 0 0 0-.777.66l-1.525 8.012z"></path>
                <path d="M18.847 8.085c-.433 2.73-2.394 4.58-5.187 4.58h-3.082a.789.789 0 0 0-.777.66l-1.525 8.012h4.606a.641.641 0 0 0 .633-.538l.68-4.304a.789.789 0 0 1 .777-.66h1.936c3.226 0 5.327-1.604 4.858-4.568-.31-1.956-1.564-3.182-2.92-3.182z" opacity="0.65"></path>
              </svg>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
                  <span class="text-[14px] font-semibold text-brand-dark">PayPal</span>
                  <span class="rounded-full bg-brand-dark px-2 py-0.5 text-xs font-semibold leading-none text-brand-sand">+5% extra</span>
                </div>
                <span class="block text-xs text-ink-muted">Internacional</span>
              </div>
            </div>

            <!-- 5. Zelle (+5% extra) -->
            <div class="flex items-center gap-3 rounded-card bg-sunken p-4 sm:col-span-3">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 text-brand-dark" aria-hidden="true">
                <line x1="12" y1="2" x2="12" y2="22"></line>
                <polyline points="7 6 17 6 7 18 17 18"></polyline>
              </svg>
              <div class="min-w-0">
                <div class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
                  <span class="text-[14px] font-semibold text-brand-dark">Zelle</span>
                  <span class="rounded-full bg-brand-dark px-2 py-0.5 text-xs font-semibold leading-none text-brand-sand">+5% extra</span>
                </div>
                <span class="block text-xs text-ink-muted">Directo en USD</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
